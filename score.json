{
  "schema": "exogibbs_condensate_head_route_scorecard_v1",
  "policy": {
    "fastchem4_is_comparison_target_only": true,
    "fastchem4_constructor_inputs_used": false,
    "fastchem4_exact_replay_target": false,
    "markdown_companion": "score.md"
  },
  "metric_priorities": [
    {
      "metric": "public_convergence_budget_gate",
      "purpose": "Confirm whether the public API result remains acceptable.",
      "improvement_direction": "Keep converged rows and avoid new budget-gate rejects."
    },
    {
      "metric": "exogibbs_native_gibbs_over_rt",
      "purpose": "Check whether implementation changes worsen the ExoGibbs-native objective.",
      "improvement_direction": "Decrease or do not increase before/after G/RT."
    },
    {
      "metric": "inactive_positive_condensate_driving",
      "purpose": "Detect condensates outside support that still strongly want to condense.",
      "improvement_direction": "Decrease maximum driving and count."
    },
    {
      "metric": "fastchem4_gas_abundance_difference",
      "purpose": "Detect large public gas abundance outliers against FastChem4.",
      "improvement_direction": "Decrease max absolute log10 gas ratio."
    },
    {
      "metric": "active_condensate_jaccard",
      "purpose": "Track active condensate list similarity to FastChem4 without exact replay.",
      "improvement_direction": "Increase mean and minimum Jaccard."
    },
    {
      "metric": "fastchem4_scaled_gibbs_comparison",
      "purpose": "Evaluate ExoGibbs and budget-scaled FastChem4 states under the same ExoGibbs-native objective.",
      "improvement_direction": "Increase ExoGibbs-lower count and decrease max absolute dG/RT."
    },
    {
      "metric": "route_support_churn",
      "purpose": "Confirm whether a trial changes only intended rows.",
      "improvement_direction": "Keep route/support changes localized and justified by G/RT or residual improvements."
    },
    {
      "metric": "global_inactive_driving_distribution",
      "purpose": "Track the full-layer distribution rather than only selected hotspots.",
      "improvement_direction": "Decrease p90, p95, max, and threshold exceedance counts."
    },
    {
      "metric": "amount_floor_active_set_sensitivity",
      "purpose": "Separate real active support changes from near-zero amount floor artifacts.",
      "improvement_direction": "Avoid large floor-dependent active-count churn unless G/RT and residuals improve."
    },
    {
      "metric": "gas_outlier_attribution",
      "purpose": "Tie large gas log10-ratio rows to species, layer, and potentially related inactive condensates.",
      "improvement_direction": "Decrease top attributed outliers and explain remaining species families."
    },
    {
      "metric": "residual_component_distribution",
      "purpose": "Track budget, stationarity, support size, and objective distributions across all curated layers.",
      "improvement_direction": "Improve high quantiles without introducing public gate regressions."
    }
  ],
