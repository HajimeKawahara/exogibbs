digraph responses {
graph [rankdir=LR, bgcolor="white",
fontname="DejaVu Sans", fontsize=16, labelloc=t, nodesep=0.34, ranksep=1.0,
label="Local equilibrium responses: controls -> species amounts\nBlue = positive; orange dashed = negative; labels = d ln(n) / d ln(control)\n|response| >= 0.15 shown; width = 0.7 + 1.3 min(|response|, 3). Display pruning only; arrows are not reaction paths."];
node [fontname="DejaVu Sans", fontsize=11, margin="0.10,0.07", style=filled];
edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.65];
subgraph cluster_0 {
label="800 K | 14/25 responses shown";
color="#d0d5db"; style=rounded; margin=18;
"s0_H" [label="b_H", shape=box, fillcolor="#eef2f6"];
"s0_C" [label="b_C", shape=box, fillcolor="#eef2f6"];
"s0_O" [label="b_O", shape=box, fillcolor="#eef2f6"];
"s0_K1" [label="K1", shape=box, fillcolor="#eef2f6"];
"s0_K2" [label="K2", shape=box, fillcolor="#eef2f6"];
"s0_H2" [label="H2\nx = 8.10e-01", shape=ellipse, fillcolor="#fff9e8"];
"s0_H2O" [label="H2O\nx = 1.26e-01", shape=ellipse, fillcolor="#fff9e8"];
"s0_CO" [label="CO\nx = 4.61e-04", shape=ellipse, fillcolor="#fff9e8"];
"s0_CO2" [label="CO2\nx = 3.06e-04", shape=ellipse, fillcolor="#fff9e8"];
"s0_CH4" [label="CH4\nx = 6.30e-02", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", penwidth=2.5, fontname="DejaVu Sans Bold"];
{ rank=same; "s0_H"; "s0_C"; "s0_O"; "s0_K1"; "s0_K2"; }
"s0_K2" -> "s0_K1" -> "s0_O" -> "s0_C" -> "s0_H" [style=invis, weight=100];
{ rank=same; "s0_H2"; "s0_H2O"; "s0_CO"; "s0_CO2"; "s0_CH4"; }
"s0_CH4" -> "s0_CO2" -> "s0_CO" -> "s0_H2O" -> "s0_H2" [style=invis, weight=100];
"s0_H" -> "s0_H2" [style=invis, weight=1000, minlen=3];
"s0_C" -> "s0_H2O" [style=invis, weight=1000, minlen=3];
"s0_O" -> "s0_CO" [style=invis, weight=1000, minlen=3];
"s0_K1" -> "s0_CO2" [style=invis, weight=1000, minlen=3];
"s0_K2" -> "s0_CH4" [style=invis, weight=1000, minlen=3];
"s0_H" -> "s0_H2" [label="+1.30", color="#2166ac", fontcolor="#2166ac", style=solid, constraint=false, penwidth=2.40];
"s0_H" -> "s0_CO" [label="-1.75", color="#c65d16", fontcolor="#c65d16", style=dashed, constraint=false, penwidth=2.97];
"s0_H" -> "s0_CO2" [label="-3.03", color="#c65d16", fontcolor="#c65d16", style=dashed, constraint=false, penwidth=4.60];
