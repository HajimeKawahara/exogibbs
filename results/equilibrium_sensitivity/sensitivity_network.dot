"s0_C" -> "s0_CH4" [label="+1.00", color="#2166ac", fontcolor="#2166ac", style=solid, constraint=false, penwidth=1.99];
"s0_O" -> "s0_H2" [label="-0.15", color="#c65d16", fontcolor="#c65d16", style=dashed, constraint=false, penwidth=0.90];
"s0_O" -> "s0_H2O" [label="+0.99", color="#2166ac", fontcolor="#2166ac", style=solid, constraint=false, penwidth=1.99];
"s0_O" -> "s0_CO" [label="+1.43", color="#2166ac", fontcolor="#2166ac", style=solid, constraint=false, penwidth=2.55];
"s0_O" -> "s0_CO2" [label="+2.57", color="#2166ac", fontcolor="#2166ac", style=solid, constraint=false, penwidth=4.04];
"s0_K1" -> "s0_CO" [label="-0.97", color="#c65d16", fontcolor="#c65d16", style=dashed, constraint=false, penwidth=1.97];
"s0_K1" -> "s0_CO2" [label="-0.96", color="#c65d16", fontcolor="#c65d16", style=dashed, constraint=false, penwidth=1.95];
"s0_K2" -> "s0_CO2" [label="+0.98", color="#2166ac", fontcolor="#2166ac", style=solid, constraint=false, penwidth=1.98];
}
