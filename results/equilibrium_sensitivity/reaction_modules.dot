// Diagram-only artifact; numerical solver and example outputs are unchanged.
// Numerical source: a782b40697084e48eb04dc7bc034ade7e33185ce, validation.json.
// Reproduce: dot -Tpng -Gdpi=150 reaction_modules.dot -o reaction_modules.png
// Reaction neighborhoods are extracted with nx.ego_graph(G, reaction, radius=1).
// Source: validation.json reaction_columns and physical_controls, 1000 K.
// Gray edge labels are stoichiometric coefficients; colored outer edges are sensitivities.
digraph reactions {
graph [rankdir=LR, compound=true, newrank=true, bgcolor=white, nodesep=0.42, ranksep=0.65, pad=0.22,
fontname="DejaVu Sans", fontsize=17, labelloc=t, label="Each q component contains four species and one equilibrium condition\n1000 K, 1 bar | Left to right: T/P -> named component -> CH4\nOuter arrows: blue positive, orange dashed negative | Inner gray edges: signed stoichiometry"];
node [fontname="DejaVu Sans", fontsize=16, margin="0.13,0.08", style=filled, color="#374151", penwidth=1.2];
edge [fontname="DejaVu Sans", fontsize=14, arrowsize=0.75];
T [label="T", shape=box, fillcolor="#eef2f6"];
P [label="P", shape=box, fillcolor="#eef2f6"];
CH4 [label="CH4", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", penwidth=2.3, fontname="DejaVu Sans Bold"];
{rank=same; T; P;}
P -> T [style=invis, weight=100];
subgraph cluster_q1 {
graph [label="q1 | Methanation\nq1 = ln K1(T) + 2 ln(P/P0)", fontname="DejaVu Sans Bold", fontsize=18, color="#374151", style="rounded,filled", fillcolor="#fff9e8", margin=22];
q1_balance [label="r1\nbalance", shape=box, style="rounded,filled", fillcolor="#fff9e8"];
q1_H2 [label="H2", shape=ellipse, fillcolor="#ffffff"];
q1_H2 -> q1_balance [dir=none, label="-3", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
q1_H2O [label="H2O", shape=ellipse, fillcolor="#ffffff"];
q1_balance -> q1_H2O [dir=none, label="+1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
q1_CO [label="CO", shape=ellipse, fillcolor="#ffffff"];
q1_CO -> q1_balance [dir=none, label="-1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
q1_CH4 [label="CH4", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", penwidth=2.3, fontname="DejaVu Sans Bold"];
q1_balance -> q1_CH4 [dir=none, label="+1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
{rank=same; q1_H2; q1_CO;}
{rank=same; q1_H2O; q1_CH4;}
q1_in [label="", shape=point, style=invis, width=0.01, height=0.01];
q1_out [label="", shape=point, style=invis, width=0.01, height=0.01];
{rank=same; q1_H2; q1_in; q1_CO;}
{rank=same; q1_H2O; q1_out; q1_CH4;}
q1_in -> q1_balance -> q1_out [style=invis, weight=100];
q1_H2 -> q1_in -> q1_CO [style=invis, weight=100];
q1_H2O -> q1_out -> q1_CH4 [style=invis, weight=100];
}
T -> q1_in [lhead=cluster_q1, label="-27.073", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=3.800];
P -> q1_in [lhead=cluster_q1, label="+2", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=1.040];
q1_out -> CH4 [ltail=cluster_q1, label="+0.59252", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=0.871];
subgraph cluster_q2 {
graph [label="q2 | Water-gas shift\nq2 = ln K2(T)", fontname="DejaVu Sans Bold", fontsize=18, color="#374151", style="rounded,filled", fillcolor="#fff9e8", margin=22];
q2_balance [label="r2\nbalance", shape=box, style="rounded,filled", fillcolor="#fff9e8"];
q2_H2 [label="H2", shape=ellipse, fillcolor="#ffffff"];
q2_balance -> q2_H2 [dir=none, label="+1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
q2_H2O [label="H2O", shape=ellipse, fillcolor="#ffffff"];
q2_H2O -> q2_balance [dir=none, label="-1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
q2_CO [label="CO", shape=ellipse, fillcolor="#ffffff"];
q2_CO -> q2_balance [dir=none, label="-1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
q2_CO2 [label="CO2", shape=ellipse, fillcolor="#ffffff"];
q2_balance -> q2_CO2 [dir=none, label="+1", color="#6b7280", fontcolor="#6b7280", penwidth=1.5];
{rank=same; q2_H2O; q2_CO;}
{rank=same; q2_H2; q2_CO2;}
q2_in [label="", shape=point, style=invis, width=0.01, height=0.01];
q2_out [label="", shape=point, style=invis, width=0.01, height=0.01];
{rank=same; q2_H2O; q2_in; q2_CO;}
{rank=same; q2_H2; q2_out; q2_CO2;}
q2_in -> q2_balance -> q2_out [style=invis, weight=100];
q2_H2O -> q2_in -> q2_CO [style=invis, weight=100];
q2_H2 -> q2_out -> q2_CO2 [style=invis, weight=100];
}
T -> q2_in [lhead=cluster_q2, label="-4.1882", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=1.303];
q2_out -> CH4 [ltail=cluster_q2, label="-0.017041", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=0.802];
{rank=same; q1_H2; q1_CO; q1_in; q2_H2O; q2_CO; q2_in;}
{rank=same; q1_balance; q2_balance;}
{rank=same; q1_H2O; q1_CH4; q1_out; q2_H2; q2_CO2; q2_out;}
q1_balance -> q2_balance [style=invis, weight=100];
}
