// PR illustration expanding the two intermediate nodes in methane_reduction.png.
// Source: a782b40697084e48eb04dc7bc034ade7e33185ce, validation.json physical_controls, 1000 K.
// This diagram is rendered directly from DOT; it is not an additional numerical-demo output.
// Reproduce: dot -Tpng -Gdpi=150 reaction_modules.dot -o reaction_modules.png
digraph modules {
graph [rankdir=LR, compound=true, newrank=true, bgcolor=white, nodesep=0.65, ranksep=0.9, pad=0.25,
fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Inside the q1 and q2 ovals | 1000 K, 1 bar, fixed elemental amounts\nPhysical inputs -> equilibrium conditions -> methane response\nBlue: positive sensitivity | Orange dashed: negative sensitivity | Gray: reversible reaction"];
node [fontname="DejaVu Sans", fontsize=18, margin="0.16,0.12", style=filled, color="#374151", penwidth=1.3];
edge [fontname="DejaVu Sans", fontsize=16, arrowsize=0.8];
T [label="T", shape=box, fillcolor="#eef2f6"];
P [label="P", shape=box, fillcolor="#eef2f6"];
CH4 [label="CH4", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", fontname="DejaVu Sans Bold", penwidth=2.3];
{rank=same; T; P;}
T -> P [style=invis, weight=100];
subgraph cluster_q1 {
graph [label="q1  |  Methanation\nq1 = ln K1(T) + 2 ln(P/P0)", fontname="DejaVu Sans Bold", fontsize=20, color="#374151", style="rounded,filled", fillcolor="#fff9e8", margin=25];
q1_lhs [label="CO  +  3 H2", shape=box, style="rounded,filled", fillcolor=white];
q1_rhs [label="CH4  +  H2O", shape=box, style="rounded,filled", fillcolor=white];
q1_lhs -> q1_rhs [dir=both, color="#6b7280", fontcolor="#6b7280", penwidth=1.6, label="equilibrium", minlen=1];
}
T -> q1_lhs [lhead=cluster_q1, label="-27.073", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=3.800];
P -> q1_lhs [lhead=cluster_q1, label="+2", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=1.040];
q1_rhs -> CH4 [ltail=cluster_q1, label="+0.59252", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=0.871];
subgraph cluster_q2 {
graph [label="q2  |  Water-gas shift\nq2 = ln K2(T)", fontname="DejaVu Sans Bold", fontsize=20, color="#374151", style="rounded,filled", fillcolor="#fff9e8", margin=25];
q2_lhs [label="CO  +  H2O", shape=box, style="rounded,filled", fillcolor=white];
q2_rhs [label="CO2  +  H2", shape=box, style="rounded,filled", fillcolor=white];
q2_lhs -> q2_rhs [dir=both, color="#6b7280", fontcolor="#6b7280", penwidth=1.6, label="equilibrium", minlen=1];
}
T -> q2_lhs [lhead=cluster_q2, label="-4.1882", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=1.303];
q2_rhs -> CH4 [ltail=cluster_q2, label="-0.017041", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=0.802];
{rank=same; q1_lhs; q2_lhs;}
{rank=same; q1_rhs; q2_rhs;}
q2_lhs -> q1_lhs [style=invis, weight=100];
q2_rhs -> q1_rhs [style=invis, weight=100];
}
