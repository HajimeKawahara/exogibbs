digraph response {
graph [rankdir=LR, bgcolor=white, nodesep=0.5, ranksep=0.8,
fontname="DejaVu Sans", fontsize=16, labelloc=t, label="Methane response at 1000 K: factorization, selection, exact collapse\nq = ln K(T) - delta_nu ln(P/P0); pressure changes q, not ideal-gas K\nA/B edges: dq / d ln(T or P), then d ln(n_CH4) / dq; C: d ln(n_CH4) / d ln(T or P)\nBlue positive; orange dashed negative. Separate views; do not add direct and factorized edges."];
node [fontname="DejaVu Sans", fontsize=13, style=filled, margin="0.15,0.09"];
edge [fontname="DejaVu Sans", fontsize=12, arrowsize=0.75];
subgraph cluster_0 {
label="A. Full two-equilibrium basis\nT path products: -16.04105, +0.07137";
color="#d0d5db"; style=rounded; margin=20;
"p0_T" [label="T", shape=box, fillcolor="#eef2f6"];
"p0_P" [label="P", shape=box, fillcolor="#eef2f6"];
"p0_CH4" [label="CH4", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", penwidth=2.3, fontname="DejaVu Sans Bold"];
"p0_q1" [label="q1\nmethanation", shape=ellipse, fillcolor="#fff9e8"];
"p0_q2" [label="q2\nwater-gas shift", shape=ellipse, fillcolor="#fff9e8"];
{rank=same; "p0_T"; "p0_P";}
{rank=same; "p0_q1"; "p0_q2";}
{rank=same; "p0_CH4";}
"p0_T" -> "p0_q1" [label="-27.073", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=3.800];
"p0_T" -> "p0_q2" [label="-4.1882", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=1.303];
"p0_P" -> "p0_q1" [label="+2", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=1.040];
"p0_q1" -> "p0_CH4" [label="+0.59252", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=0.871];
"p0_q2" -> "p0_CH4" [label="-0.017041", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=0.802];
}
subgraph cluster_1 {
label="B. Approximate: keep >=99% of absolute path contributions\nT retained: -16.04105; omitted: +0.07137\nRetained absolute fraction: 99.557%";
color="#d0d5db"; style=rounded; margin=20;
"p1_T" [label="T", shape=box, fillcolor="#eef2f6"];
"p1_P" [label="P", shape=box, fillcolor="#eef2f6"];
"p1_CH4" [label="CH4", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", penwidth=2.3, fontname="DejaVu Sans Bold"];
"p1_q1" [label="q1\nmethanation", shape=ellipse, fillcolor="#fff9e8"];
{rank=same; "p1_T"; "p1_P";}
{rank=same; "p1_q1";}
{rank=same; "p1_CH4";}
"p1_T" -> "p1_q1" [label="-27.073", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=3.800];
"p1_P" -> "p1_q1" [label="+2", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=1.040];
"p1_q1" -> "p1_CH4" [label="+0.59252", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=0.871];
}
"p0_CH4" -> "p1_T" [style=invis, minlen=2, weight=100];
subgraph cluster_2 {
label="C. Exact collapse\nSigned sum over ALL path products";
color="#d0d5db"; style=rounded; margin=20;
"p2_T" [label="T", shape=box, fillcolor="#eef2f6"];
"p2_P" [label="P", shape=box, fillcolor="#eef2f6"];
"p2_CH4" [label="CH4", shape=ellipse, fillcolor="#eee7f5", color="#6a3d9a", penwidth=2.3, fontname="DejaVu Sans Bold"];
{rank=same; "p2_T"; "p2_P";}
{rank=same; "p2_CH4";}
"p2_T" -> "p2_CH4" [label="-15.97", color="#c65d16", fontcolor="#c65d16", style=dashed, penwidth=2.716];
"p2_P" -> "p2_CH4" [label="+1.185", color="#2166ac", fontcolor="#2166ac", style=solid, penwidth=0.942];
}
"p1_CH4" -> "p2_T" [style=invis, minlen=2, weight=100];
}
